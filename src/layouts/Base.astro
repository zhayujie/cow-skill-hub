---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Browse, search, and install skills for CowAgent' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - CowAgent Skill Hub</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/logo/cow-logo.png" />
</head>
<style is:global>
  .scrollbar-thin::-webkit-scrollbar { height: 2px; }
  .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
  .scrollbar-thin::-webkit-scrollbar-thumb { background: transparent; border-radius: 2px; transition: background 0.2s; }
  .scrollbar-thin:hover::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); }
  .scrollbar-thin { scrollbar-width: thin; scrollbar-color: transparent transparent; }
  .scrollbar-thin:hover { scrollbar-color: rgba(255,255,255,0.2) transparent; }
</style>
<body class="bg-surface text-gray-200 font-sans antialiased">
  <nav class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-xl border-b border-border">
    <div class="max-w-content mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 font-bold text-lg">
        <img src="/logo/cow-logo.png" alt="CowAgent" class="w-8 h-8 rounded-lg" />
        <span class="text-gray-200">Skill Hub</span>
      </a>
      <div class="flex items-center gap-6">
        <a href="/" class="text-sm text-gray-400 hover:text-gray-200 transition-colors">Skills</a>
        <a href="https://docs.cowagent.ai" target="_blank" class="text-sm text-gray-400 hover:text-gray-200 transition-colors">Docs</a>
        <a href="https://cowagent.ai" target="_blank" class="text-sm text-gray-400 hover:text-gray-200 transition-colors">CowAgent</a>
        <a
          href="https://github.com/zhayujie/chatgpt-on-wechat"
          target="_blank"
          class="flex items-center gap-1.5 text-gray-400 hover:text-gray-200 transition-colors px-2.5 py-1 border border-border-light rounded-md text-sm"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <main class="pt-16">
    <slot />
  </main>

  <footer class="border-t border-border mt-20 py-10 px-6">
    <div class="max-w-content mx-auto flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-2.5">
        <img src="/logo/cow-logo.png" alt="CowAgent" class="w-7 h-7 rounded-md" />
        <span class="font-semibold">CowAgent Skill Hub</span>
      </div>
      <div class="flex gap-6">
        <a href="https://cowagent.ai" target="_blank" class="text-sm text-gray-500 hover:text-gray-300 transition-colors">CowAgent</a>
        <a href="https://docs.cowagent.ai" target="_blank" class="text-sm text-gray-500 hover:text-gray-300 transition-colors">Docs</a>
        <a href="https://github.com/zhayujie/chatgpt-on-wechat" target="_blank" class="text-sm text-gray-500 hover:text-gray-300 transition-colors">GitHub</a>
      </div>
    </div>
    <div class="max-w-content mx-auto mt-6 pt-5 border-t border-border text-center">
      <p class="text-xs text-gray-600">&copy; 2026 CowAgent. Open source under MIT License.</p>
    </div>
  </footer>
</body>
</html>
