---
import Base from '@/layouts/Base.astro';
import SkillCard from '@/components/SkillCard.astro';
import { categories, tagOptions } from '@/data/skills';
import { getAllSkills, getTagDefinitions } from '@/data/db';

const runtime = Astro.locals?.runtime;
const db = runtime?.env?.DB || null;

const allSkills = await getAllSkills(db);
const dbTags = await getTagDefinitions(db);
const tags = dbTags.length > 0 ? dbTags : tagOptions;
const tagMap: Record<string, string> = {};
for (const t of tags) { tagMap[t.id] = t.name; }
---

<Base title="Skill Hub">
  <!-- Hero -->
  <section class="pt-20 pb-12 px-6 text-center">
    <div class="max-w-content mx-auto">
      <div class="inline-block px-4 py-1.5 bg-primary/8 border border-primary/20 rounded-full text-xs text-primary mb-7 tracking-wide">
        CowAgent Skill Hub
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight mb-6 bg-gradient-to-br from-white to-gray-300 bg-clip-text text-transparent">
        发现和安装技能
      </h1>
      <p class="max-w-xl mx-auto text-base text-gray-300 leading-relaxed mb-10">
        浏览官方推荐和社区贡献的 Skills，一行命令即可为你的 Agent 扩展新能力
      </p>

      <!-- Search -->
      <div class="max-w-lg mx-auto relative mb-6">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          id="searchInput"
          type="text"
          placeholder="搜索技能名称、描述或标签..."
          class="w-full pl-11 pr-4 py-3 bg-surface-card border border-border rounded-xl text-sm text-gray-200 placeholder-gray-500 focus:outline-none focus:border-primary/50 transition-colors"
        />
      </div>

      <!-- Install hint -->
      <div class="max-w-lg mx-auto bg-surface-card border border-border rounded-xl px-5 py-3 flex items-center justify-between">
        <code class="text-sm text-gray-400 font-mono">
          <span class="text-primary">$</span> cow skill install &lt;name&gt;
        </code>
        <button
          id="copyInstallBtn"
          class="text-xs text-gray-500 hover:text-primary border border-border-light rounded-md px-3 py-1 transition-colors cursor-pointer"
        >
          复制
        </button>
      </div>
    </div>
  </section>

  <!-- Filters -->
  <section class="px-6 mb-10">
    <div class="max-w-content mx-auto space-y-3">
      <!-- Category row -->
      <div class="flex items-center gap-3 overflow-x-auto pb-1">
        {categories.map(cat => (
          <button
            data-category={cat.id}
            class:list={[
              'category-btn px-5 py-2 rounded-full text-sm font-medium border transition-all duration-200 cursor-pointer whitespace-nowrap',
              cat.id === 'all'
                ? 'bg-primary/10 text-primary border-primary/20'
                : 'bg-surface-card text-gray-400 border-border hover:border-border-light hover:text-gray-300'
            ]}
          >
            {cat.name}
          </button>
        ))}
      </div>
      <!-- Tag row -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1">
        <span class="text-xs text-gray-600 shrink-0">标签</span>
        {tags.map(tag => (
          <button
            data-tag={tag.id}
            class="tag-btn px-3 py-1 rounded-md text-xs font-medium border transition-all duration-200 cursor-pointer whitespace-nowrap bg-transparent text-gray-500 border-border hover:border-border-light hover:text-gray-300"
          >
            {tag.name}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills Grid -->
  <section class="px-6 pb-20">
    <div class="max-w-content mx-auto">
      <div id="skillsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {allSkills.map((skill, i) => (
          <div class="h-full" data-skill-name={skill.name} data-skill-category={skill.category} data-skill-featured={skill.featured ? '1' : '0'} data-skill-tags={skill.tags.join(',')} data-skill-provider={skill.sourceProvider} style={i >= 30 ? 'display:none' : ''}>
            <SkillCard skill={skill} tagMap={tagMap} />
          </div>
        ))}
      </div>

      <!-- Load more -->
      <div id="loadMoreWrap" class:list={['text-center pt-8', allSkills.length <= 30 && 'hidden']}>
        <button id="loadMoreBtn" class="px-8 py-2.5 rounded-full text-sm font-medium border border-border text-gray-400 bg-surface-card hover:border-border-light hover:text-gray-300 transition-all duration-200 cursor-pointer">
          加载更多
        </button>
        <p id="skillCount" class="text-xs text-gray-600 mt-3">已显示 30 / {allSkills.length} 个技能</p>
      </div>

      <div id="emptyState" class="hidden text-center py-20">
        <svg class="mx-auto mb-4 text-gray-600" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <p class="text-gray-500">未找到匹配的技能</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const PAGE_SIZE = 30;

    const searchInput = document.getElementById('searchInput');
    const skillsGrid = document.getElementById('skillsGrid');
    const emptyState = document.getElementById('emptyState');
    const loadMoreWrap = document.getElementById('loadMoreWrap');
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    const skillCount = document.getElementById('skillCount');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const tagBtns = document.querySelectorAll('.tag-btn');
    const allCards = Array.from(skillsGrid.querySelectorAll('[data-skill-name]'));

    let currentCategory = 'all';
    const activeTags = new Set();
    let matched = [];
    let showCount = 0;
    let isFiltering = false;

    const CAT_ACTIVE = 'category-btn px-5 py-2 rounded-full text-sm font-medium border transition-all duration-200 cursor-pointer whitespace-nowrap bg-primary/10 text-primary border-primary/20';
    const CAT_INACTIVE = 'category-btn px-5 py-2 rounded-full text-sm font-medium border transition-all duration-200 cursor-pointer whitespace-nowrap bg-surface-card text-gray-400 border-border hover:border-border-light hover:text-gray-300';
    const TAG_ACTIVE = 'tag-btn px-3 py-1 rounded-md text-xs font-medium border transition-all duration-200 cursor-pointer whitespace-nowrap bg-primary/10 text-primary border-primary/20';
    const TAG_INACTIVE = 'tag-btn px-3 py-1 rounded-md text-xs font-medium border transition-all duration-200 cursor-pointer whitespace-nowrap bg-transparent text-gray-500 border-border hover:border-border-light hover:text-gray-300';

    function filterSkills() {
      const query = searchInput.value.toLowerCase().trim();
      isFiltering = !!(query || currentCategory !== 'all' || activeTags.size > 0);

      matched = allCards.filter(card => {
        const name = card.dataset.skillName.toLowerCase();
        const cat = card.dataset.skillCategory;
        const featured = card.dataset.skillFeatured === '1';
        const tags = card.dataset.skillTags.toLowerCase().split(',').filter(Boolean);
        const text = card.textContent.toLowerCase();

        const matchCategory = currentCategory === 'all'
          || (currentCategory === 'featured' ? featured : cat === currentCategory);
        const matchSearch = !query || name.includes(query) || tags.some(t => t.includes(query)) || text.includes(query);
        const matchTags = activeTags.size === 0 || tags.some(t => activeTags.has(t));

        return matchCategory && matchSearch && matchTags;
      });

      showCount = isFiltering ? matched.length : Math.min(PAGE_SIZE, matched.length);
      renderVisible();
    }

    function renderVisible() {
      const visibleSet = new Set(matched.slice(0, showCount));

      allCards.forEach(card => {
        card.style.display = visibleSet.has(card) ? '' : 'none';
      });

      const hasMore = showCount < matched.length;
      loadMoreWrap.classList.toggle('hidden', !hasMore);
      if (hasMore) {
        skillCount.textContent = '已显示 ' + showCount + ' / ' + matched.length + ' 个技能';
      }

      emptyState.classList.toggle('hidden', matched.length > 0);
    }

    function loadMore() {
      showCount = Math.min(showCount + PAGE_SIZE, matched.length);
      renderVisible();
    }

    loadMoreBtn.addEventListener('click', loadMore);

    // Infinite scroll: load more when near bottom
    let scrollTicking = false;
    window.addEventListener('scroll', () => {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(() => {
        scrollTicking = false;
        if (showCount >= matched.length) return;
        const scrollBottom = window.innerHeight + window.scrollY;
        if (scrollBottom >= document.body.offsetHeight - 400) {
          loadMore();
        }
      });
    });

    searchInput.addEventListener('input', filterSkills);

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.dataset.category;
        categoryBtns.forEach(b => {
          b.className = b.dataset.category === currentCategory ? CAT_ACTIVE : CAT_INACTIVE;
        });
        filterSkills();
      });
    });

    tagBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag;
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
          btn.className = TAG_INACTIVE;
        } else {
          activeTags.add(tag);
          btn.className = TAG_ACTIVE;
        }
        filterSkills();
      });
    });

    document.getElementById('copyInstallBtn').addEventListener('click', function() {
      navigator.clipboard.writeText('cow skill install <name>');
      this.textContent = '已复制!';
      this.classList.add('text-primary', 'border-primary/30');
      setTimeout(() => {
        this.textContent = '复制';
        this.classList.remove('text-primary', 'border-primary/30');
      }, 2000);
    });

    // Initial render: show first page
    filterSkills();

  </script>
</Base>
