---
import SkillDetail from '@/components/SkillDetail.astro';
import NotFound from '@/components/NotFound.astro';
import { tagOptions, localizeSkill } from '@/data/skills';
import { getSkillByName, getTagDefinitions } from '@/data/db';
import { getAppContext } from '@/server/context';
import { DEFAULT_LANG, tagLabel } from '@/i18n';

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const { name } = Astro.params;
const db = (await getAppContext(Astro.locals)).db;

const skill = await getSkillByName(db, name!);
if (!skill) {
  Astro.response.status = 404;
}

const dbTags = skill ? await getTagDefinitions(db) : [];
const tagMap: Record<string, string> = {};
for (const tag of dbTags.length > 0 ? dbTags : tagOptions) {
  tagMap[tag.id] = tagLabel(tag.id, tag.name, lang);
}
---

{skill ? <SkillDetail skill={localizeSkill(skill, lang)} tagMap={tagMap} /> : <NotFound />}
